# ─────────────────────────────────────────────────────────────────
# Fixia — .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Secretos / variables de entorno ──────────────────────────────
# NUNCA subir los .env reales (contienen API keys). Sí se versionan
# las plantillas .env.example.
.env
.env.*
!.env.example
!**/.env.example

# ── Python / FastAPI ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Modelos ML entrenados y artefactos generados ─────────────────
*.pkl
*.joblib
modelos_ml/metricas/resultados_metricas.csv
modelos_ml/metricas/resultados_metricas.json

# ── CSVs generados automáticamente desde la BD ───────────────────
# (el CSV semilla csv/taller_4.csv sí está versionado)
csv/general.csv
csv/taller_*.csv
!csv/taller_4.csv

# ── Editores / IDE ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Sistema operativo ────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ── Logs ─────────────────────────────────────────────────────────
*.log
